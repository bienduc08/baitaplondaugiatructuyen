<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.MyAuctionsController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <children>
                <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label text="Danh sách phiên đấu giá của tôi" textFill="#1e293b">
                            <font><Font name="System Bold" size="26.0" /></font>
                        </Label>
                        <Label text="Quản lý các sản phẩm bạn đã đăng tải lên hệ thống" textFill="#64748b" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <children>
                <TextField fx:id="txtSearch" prefHeight="38.0" prefWidth="350.0" promptText="Tìm theo tên sản phẩm hoặc ID..." style="-fx-background-radius: 8; -fx-background-color: #f1f5f9; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" />
                <ComboBox fx:id="cbStatusFilter" prefHeight="38.0" prefWidth="160.0" promptText="Tất cả trạng thái" style="-fx-background-radius: 8;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-cursor: hand;" text="Làm mới" />
            </children>
        </HBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="tblMyAuctions" style="-fx-background-color: transparent; -fx-selection-bar: #f1f5f9;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80.0" text="Mã số" />
                        <TableColumn fx:id="colName" prefWidth="280.0" text="Sản phẩm" />
                        <TableColumn fx:id="colCurrentPrice" prefWidth="150.0" text="Giá hiện tại" />
                        <TableColumn fx:id="colBids" prefWidth="100.0" text="Lượt đặt" />
                        <TableColumn fx:id="colStatus" prefWidth="140.0" text="Trạng thái" />
                        <TableColumn fx:id="colActions" prefWidth="150.0" text="Hành động" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Label style="-fx-font-size: 12;" text="Hiển thị 1-10 trên tổng số 25 sản phẩm" textFill="#94a3b8" />
                <HBox spacing="5.0">
                    <children>
                        <Button style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" text="&lt;" />
                        <Button style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5;" text="1" />
                        <Button style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" text="2" />
                        <Button style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 5;" text="&gt;" />
                    </children>
                </HBox>
            </children>
        </HBox>
    </children>
</VBox>
