<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600.0" prefWidth="782.0" spacing="15.0" style="-fx-padding: 20;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.HomecontentController">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="400.0" promptText="Tìm kiếm sản phẩm..." style="-fx-background-radius: 20; -fx-border-color: #dcdde1; -fx-border-radius: 20;" />
    </HBox>
    <HBox spacing="8.0">
        <Button onAction="#onFilterAll" style="-fx-background-radius: 15;" text="Tất cả" />
        <Button onAction="#onFilterElectronics" style="-fx-background-radius: 15;" text="Đồ điện tử" />
        <Button onAction="#onFilterFashion" style="-fx-background-radius: 15;" text="Thời trang" />
    </HBox>
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <FlowPane fx:id="productContainer" hgap="20.0" vgap="20.0" />
        </content>
    </ScrollPane>
</VBox>