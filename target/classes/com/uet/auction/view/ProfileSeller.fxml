<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.ProfileSellerController"
      style="-fx-background-color: #0d1f0f;">

    <!-- HEADER -->
    <HBox prefHeight="150.0"
          style="-fx-background-color: linear-gradient(to right, #0d1f0f, #14532d, #15803d);
                 -fx-padding: 30 36 30 36; -fx-border-color: #166534; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT" spacing="22.0">
        <StackPane>
            <Circle radius="52.0" style="-fx-fill: linear-gradient(to bottom right,#15803d,#166534);
                     -fx-stroke: #4ade80; -fx-stroke-width: 2.5;"/>
            <Label text="🏪" style="-fx-font-size: 30;"/>
        </StackPane>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label fx:id="lblUsername" text="Người bán" textFill="white"
                   style="-fx-font-size: 26; -fx-font-weight: bold;"/>
            <Label fx:id="lblRole" text="🏪 Người bán"
                   style="-fx-background-color: rgba(21,128,61,0.6); -fx-text-fill: #86efac;
                          -fx-font-size: 12; -fx-font-weight: bold;
                          -fx-padding: 4 16; -fx-background-radius: 20;"/>
        </VBox>
        <VBox spacing="6.0" alignment="CENTER_RIGHT">
            <Label fx:id="lblHeaderName" text="👤 Người bán"
                   style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <Label fx:id="lblHeaderEmail" text="✉ seller@gmail.com"
                   style="-fx-text-fill: #86efac; -fx-font-size: 12;"/>
        </VBox>
    </HBox>

    <!-- BODY -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="20.0" style="-fx-padding: 28 32 32 32; -fx-background-color: #0d1f0f;">

            <!-- STATS ROW -->
            <HBox spacing="16.0">
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: #14261a; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-border-color: #166534; -fx-border-radius: 16; -fx-border-width: 1;
                             -fx-effect: dropshadow(three-pass-box,rgba(74,222,128,0.25),16,0,0,4);">
                    <Label text="💰  SỐ DƯ" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #4b7a5a;"/>
                    <Label fx:id="lblBalance" text="0 VNĐ"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #4ade80;"/>
                    <Label text="Tổng số dư hiện có" style="-fx-font-size: 11; -fx-text-fill: #374151;"/>
                    <Button onAction="#onDepositClick" text="💳  Nạp tiền"
                            style="-fx-background-color: linear-gradient(to right,#15803d,#166534);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;
                                   -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 8 16;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: #14261a; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-border-color: #166534; -fx-border-radius: 16; -fx-border-width: 1;
                             -fx-effect: dropshadow(three-pass-box,rgba(251,146,60,0.2),16,0,0,4);">
                    <Label text="📦  SẢN PHẨM ĐÃ ĐĂNG" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #4b7a5a;"/>
                    <Label fx:id="lblTotalBids" text="0"
                           style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #fb923c;"/>
                    <Label text="Tổng sản phẩm" style="-fx-font-size: 11; -fx-text-fill: #374151;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: #14261a; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-border-color: #166534; -fx-border-radius: 16; -fx-border-width: 1;
                             -fx-effect: dropshadow(three-pass-box,rgba(16,185,129,0.2),16,0,0,4);">
                    <Label text="🔖  TRẠNG THÁI" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #4b7a5a;"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Circle radius="7.0" style="-fx-fill: #10b981;"/>
                        <Label text="Đang hoạt động"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                    </HBox>
                    <Label text="Tài khoản được xác minh" style="-fx-font-size: 11; -fx-text-fill: #374151;"/>
                </VBox>
            </HBox>

            <!-- LỊCH SỬ SẢN PHẨM - có thể cuộn bằng chuột -->
            <VBox spacing="14.0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #14261a; -fx-background-radius: 16;
                         -fx-padding: 24 28; -fx-border-color: #166534; -fx-border-radius: 16; -fx-border-width: 1;
                         -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.5),12,0,0,4);">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="📦" style="-fx-font-size: 20;"/>
                    <VBox spacing="2.0">
                        <Label text="Lịch sử đăng sản phẩm"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #86efac;"/>
                        <Label text="Danh sách các sản phẩm bạn đã đăng lên hệ thống đấu giá"
                               style="-fx-font-size: 11; -fx-text-fill: #4b7a5a;"/>
                    </VBox>
                </HBox>
                <Separator style="-fx-background-color: #166534;"/>
                <TableView fx:id="tblMyProducts" VBox.vgrow="ALWAYS" prefHeight="360.0"
                           style="-fx-background-color: transparent; -fx-border-color: #166534;
                                  -fx-border-radius: 8; -fx-border-width: 1; -fx-table-cell-border-color: #1f3d28;">
                    <columns>
                        <TableColumn fx:id="colProdName"   prefWidth="280.0" text="Tên sản phẩm"/>
                        <TableColumn fx:id="colProdPrice"  prefWidth="160.0" text="Giá hiện tại"/>
                        <TableColumn fx:id="colProdStatus" prefWidth="120.0" text="Trạng thái"/>
                        <TableColumn fx:id="colProdTime"   prefWidth="180.0" text="Thời gian kết thúc"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 40;">
                            <Label text="📭" style="-fx-font-size: 32;"/>
                            <Label text="Bạn chưa đăng sản phẩm nào"
                                   style="-fx-font-size: 13; -fx-text-fill: #4b7a5a;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
