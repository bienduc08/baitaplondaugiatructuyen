<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.ProfileController"
      style="-fx-background-color: #f0f4f8;">

    <!-- HEADER -->
    <HBox prefHeight="140.0"
          style="-fx-background-color: linear-gradient(to right, #1b5e20, #2e7d32, #388e3c);
                 -fx-padding: 30 36 30 36;"
          alignment="CENTER_LEFT" spacing="22.0">
        <StackPane>
            <Circle radius="50.0" style="-fx-fill: rgba(255,255,255,0.15); -fx-stroke: rgba(255,255,255,0.4); -fx-stroke-width: 2;"/>
            <Label text="🏪" style="-fx-font-size: 28;"/>
        </StackPane>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label fx:id="lblUsername" text="Người bán" textFill="white"
                   style="-fx-font-size: 24; -fx-font-weight: bold;"/>
            <Label fx:id="lblRole" text="🏪 Người bán"
                   style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                          -fx-font-size: 12; -fx-font-weight: bold;
                          -fx-padding: 4 16; -fx-background-radius: 20;"/>
        </VBox>
        <VBox spacing="6.0" alignment="CENTER_RIGHT">
            <Label fx:id="lblHeaderName" text="👤 Người bán"
                   style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <Label fx:id="lblHeaderEmail" text="✉ seller@gmail.com"
                   style="-fx-text-fill: #e3f2fd; -fx-font-size: 12;"/>
        </VBox>
    </HBox>

    <!-- BODY -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="20.0" style="-fx-padding: 28 32 32 32; -fx-background-color: #f0f4f8;">

            <!-- STATS ROW -->
            <HBox spacing="16.0">
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),12,0,0,4);">
                    <Label text="💰  SỐ DƯ" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #90a4ae;"/>
                    <Label fx:id="lblBalance" text="0 VNĐ"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                    <Label text="Doanh thu tích luỹ" style="-fx-font-size: 11; -fx-text-fill: #cfd8dc;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),12,0,0,4);">
                    <Label text="📦  SẢN PHẨM" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #90a4ae;"/>
                    <Label fx:id="lblTotalBids" text="0"
                           style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #f57c00;"/>
                    <Label text="Sản phẩm đã đăng" style="-fx-font-size: 11; -fx-text-fill: #cfd8dc;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),12,0,0,4);">
                    <Label text="🔖  TRẠNG THÁI" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #90a4ae;"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Circle radius="7.0" style="-fx-fill: #43a047;"/>
                        <Label text="Đang hoạt động"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                    </HBox>
                    <Label text="Tài khoản được xác minh" style="-fx-font-size: 11; -fx-text-fill: #cfd8dc;"/>
                </VBox>
            </HBox>

            <!-- LỊCH SỬ SẢN PHẨM -->
            <VBox spacing="14.0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 16;
                         -fx-padding: 24 28; -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),12,0,0,4);">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="📦" style="-fx-font-size: 20;"/>
                    <VBox spacing="2.0">
                        <Label text="Lịch sử đăng sản phẩm &amp; Sản phẩm của tôi"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #1b5e20;"/>
                        <Label text="Danh sách các sản phẩm bạn đã đăng lên hệ thống đấu giá"
                               style="-fx-font-size: 11; -fx-text-fill: #b0bec5;"/>
                    </VBox>
                </HBox>
                <Separator/>
                <TableView fx:id="tblMyProducts" VBox.vgrow="ALWAYS" prefHeight="320.0"
                           style="-fx-background-color: transparent; -fx-border-color: #c8e6c9;
                                  -fx-border-radius: 8; -fx-border-width: 1;">
                    <columns>
                        <TableColumn fx:id="colProdName"   prefWidth="280.0" text="Tên sản phẩm"/>
                        <TableColumn fx:id="colProdPrice"  prefWidth="160.0" text="Giá hiện tại"/>
                        <TableColumn fx:id="colProdStatus" prefWidth="120.0" text="Trạng thái"/>
                        <TableColumn fx:id="colProdTime"   prefWidth="180.0" text="Thời gian kết thúc"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 40;">
                            <Label text="📭" style="-fx-font-size: 32;"/>
                            <Label text="Bạn chưa đăng sản phẩm nào"
                                   style="-fx-font-size: 13; -fx-text-fill: #90a4ae;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
