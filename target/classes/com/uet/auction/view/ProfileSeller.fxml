<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox style="-fx-background-color: #0d1f0f;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.ProfileSellerController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" prefHeight="150.0" spacing="22.0" style="-fx-background-color: linear-gradient(to right, #0d1f0f, #14532d, #15803d);                  -fx-padding: 30 36 30 36; -fx-border-color: #166534; -fx-border-width: 0 0 1 0;">
        <StackPane>
            <Circle radius="52.0" style="-fx-fill: linear-gradient(to bottom right,#15803d,#166534);                      -fx-stroke: #4ade80; -fx-stroke-width: 2.5;" />
            <Label style="-fx-font-size: 30;" text="🏪" />
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblUsername" style="-fx-font-size: 26; -fx-font-weight: bold;" text="Người bán" textFill="white" />
            <Label fx:id="lblRole" style="-fx-background-color: rgba(21,128,61,0.6); -fx-text-fill: #86efac;                           -fx-font-size: 12; -fx-font-weight: bold;                           -fx-padding: 4 16; -fx-background-radius: 20;" text="🏪 Người bán" />
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="6.0">
            <Label fx:id="lblHeaderName" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="👤 Người bán" />
            <Label fx:id="lblHeaderEmail" style="-fx-text-fill: #86efac; -fx-font-size: 12;" text="✉ seller@gmail.com" />
            <Label fx:id="lblHeaderPhoneNumber" style="-fx-text-fill: #86efac; -fx-font-size: 12;"  text="📞 SĐT" />
            <Button onAction="#onEditProfileClick"
                    style="-fx-background-color: rgba(74, 222, 128, 0.1); -fx-border-color: #4ade80; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: #4ade80; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 4 15; -fx-cursor: hand;"
                    text="✏ Chỉnh sửa hồ sơ" />
        </VBox>
    </HBox>

    <!-- BODY -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="20.0" style="-fx-padding: 28 32 32 32; -fx-background-color: #0d1f0f;">

            <!-- STATS ROW -->
            <HBox spacing="16.0">
                <VBox spacing="10.0" style="-fx-background-color: #14261a; -fx-background-radius: 16;                              -fx-padding: 24 26; -fx-border-color: #166534; -fx-border-radius: 16; -fx-border-width: 1;                              -fx-effect: dropshadow(three-pass-box,rgba(74,222,128,0.25),16,0,0,4);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #4b7a5a;" text="💰  SỐ DƯ" />
                    <Label fx:id="lblBalance" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #4ade80;" text="0 VNĐ" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #374151;" text="Tổng số dư hiện có" />
                    <Button onAction="#onDepositClick" style="-fx-background-color: linear-gradient(to right,#15803d,#166534);                                    -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;                                    -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 8 16;" text="💳  Nạp tiền" />
                </VBox>
                <VBox spacing="10.0" style="-fx-background-color: #14261a; -fx-background-radius: 16;                              -fx-padding: 24 26; -fx-border-color: #166534; -fx-border-radius: 16; -fx-border-width: 1;                              -fx-effect: dropshadow(three-pass-box,rgba(251,146,60,0.2),16,0,0,4);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #4b7a5a;" text="📦  SẢN PHẨM ĐÃ ĐĂNG" />
                    <Label fx:id="lblTotalBids" style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #fb923c;" text="0" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #374151;" text="Tổng sản phẩm" />
                </VBox>
                <VBox spacing="10.0" style="-fx-background-color: #14261a; -fx-background-radius: 16;                              -fx-padding: 24 26; -fx-border-color: #166534; -fx-border-radius: 16; -fx-border-width: 1;                              -fx-effect: dropshadow(three-pass-box,rgba(16,185,129,0.2),16,0,0,4);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #4b7a5a;" text="🔖  TRẠNG THÁI" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Circle radius="7.0" style="-fx-fill: #10b981;" />
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #10b981;" text="Đang hoạt động" />
                    </HBox>
                    <Label style="-fx-font-size: 11; -fx-text-fill: #374151;" text="Tài khoản được xác minh" />
                </VBox>
            </HBox>

            <!-- LỊCH SỬ SẢN PHẨM - có thể cuộn bằng chuột -->
            <VBox spacing="14.0" style="-fx-background-color: #14261a; -fx-background-radius: 16;                          -fx-padding: 24 28; -fx-border-color: #166534; -fx-border-radius: 16; -fx-border-width: 1;                          -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.5),12,0,0,4);" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-font-size: 20;" text="📦" />
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #86efac;" text="Lịch sử đăng sản phẩm" />
                        <Label style="-fx-font-size: 11; -fx-text-fill: #4b7a5a;" text="Danh sách các sản phẩm bạn đã đăng lên hệ thống đấu giá" />
                    </VBox>
                </HBox>
                <Separator style="-fx-background-color: #166534;" />
                <TableView fx:id="tblMyProducts" prefHeight="360.0" style="-fx-background-color: transparent; -fx-border-color: #166534;                                   -fx-border-radius: 8; -fx-border-width: 1; -fx-table-cell-border-color: #1f3d28;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProdName" prefWidth="280.0" text="Tên sản phẩm" />
                        <TableColumn fx:id="colProdPrice" prefWidth="160.0" text="Giá hiện tại" />
                        <TableColumn fx:id="colProdStatus" prefWidth="120.0" text="Trạng thái" />
                        <TableColumn fx:id="colProdTimeStart" prefWidth="75.0" text="Thời gian bắt đầu" />
                        <TableColumn fx:id="colProdTimeEnd" prefWidth="180.0" text="Thời gian kết thúc" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 40;">
                            <Label style="-fx-font-size: 32;" text="📭" />
                            <Label style="-fx-font-size: 13; -fx-text-fill: #4b7a5a;" text="Bạn chưa đăng sản phẩm nào" />
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
