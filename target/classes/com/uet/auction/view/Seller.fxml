<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="640.0" prefWidth="780.0" spacing="0"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.SellerController">
    <children>

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" prefHeight="55.0" spacing="10.0"
              style="-fx-background-color: #2f3640; -fx-padding: 0 20 0 20;">
            <children>
                <VBox spacing="2.0">
                    <children>
                        <Label text="Quản lý sản phẩm đấu giá" textFill="white">
                            <font><Font name="System Bold" size="18.0"/></font>
                        </Label>
                        <Label text="Danh sách sản phẩm bạn đang đăng bán" textFill="#dcdde1">
                            <font><Font size="11.0"/></font>
                        </Label>
                    </children>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" onAction="#handleAddNewProduct"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                        text="+ Đăng sản phẩm mới"/>
                <Button mnemonicParsing="false" onAction="#onBackButtonClick"
                        style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
                        text="← Trang chủ"/>
                <Button mnemonicParsing="false" onAction="#onLogoutButtonClick"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
                        text="Đăng xuất"/>
            </children>
        </HBox>

        <!-- THỐNG KÊ NHANH -->
        <HBox spacing="15.0" style="-fx-padding: 12 20 0 20;">
            <children>
                <VBox alignment="CENTER" prefHeight="70.0" prefWidth="140.0"
                      style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 5, 0, 0, 2);">
                    <children>
                        <Label text="Đang đấu giá" textFill="#7f8c8d"/>
                        <Label fx:id="lblActiveAuctions" text="0" textFill="#2980b9">
                            <font><Font name="System Bold" size="20.0"/></font>
                        </Label>
                    </children>
                </VBox>
                <VBox alignment="CENTER" prefHeight="70.0" prefWidth="140.0"
                      style="-fx-background-color: white; -fx-background-radius: 10;
                             -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 5, 0, 0, 2);">
                    <children>
                        <Label text="Đã chốt đơn" textFill="#7f8c8d"/>
                        <Label fx:id="lblSoldItems" text="0" textFill="#27ae60">
                            <font><Font name="System Bold" size="20.0"/></font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- FORM ĐĂNG SẢN PHẨM -->
        <VBox spacing="8.0"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 5, 0, 0, 2);
                     -fx-padding: 15;">
            <VBox.margin><Insets top="12.0" left="20.0" right="20.0"/></VBox.margin>
            <children>
                <Label text="Đăng sản phẩm mới">
                    <font><Font name="System Bold" size="14.0"/></font>
                </Label>
                <GridPane hgap="10.0" vgap="8.0">
                    <children>
                        <Label text="Tên sản phẩm:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="nameField" promptText="Nhập tên sản phẩm..."
                                   prefWidth="320.0"
                                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Giá khởi điểm (VNĐ):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="priceField" promptText="VD: 500000"
                                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Mô tả:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextArea fx:id="descriptionArea" promptText="Mô tả sản phẩm..."
                                  prefHeight="55.0" prefWidth="320.0"
                                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Ngày kết thúc:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <DatePicker fx:id="endDatePicker"
                                    GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <!-- FIX: thêm fx:id để disable khi đang gửi -->
                        <Button fx:id="btnSubmit"
                                mnemonicParsing="false"
                                onAction="#onPostProductButtonClick"
                                prefHeight="38.0" prefWidth="180.0"
                                style="-fx-background-color: #2980b9; -fx-text-fill: white;
                                       -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;"
                                text="Gửi đăng bán"/>
                        <!-- FIX: label trạng thái thay cho popup giả -->
                        <Label fx:id="lblFormStatus" text="" wrapText="true"/>
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- BẢNG SẢN PHẨM -->
        <VBox VBox.vgrow="ALWAYS" spacing="8.0"
              style="-fx-background-color: white; -fx-background-radius: 10;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 5, 0, 0, 2);
                     -fx-padding: 15;">
            <VBox.margin><Insets top="12.0" left="20.0" right="20.0" bottom="20.0"/></VBox.margin>
            <children>
                <Label text="Sản phẩm của tôi">
                    <font><Font name="System Bold" size="14.0"/></font>
                </Label>
                <TableView fx:id="tableSellerProducts" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId"         prefWidth="50.0"  text="ID"/>
                        <TableColumn fx:id="colName"       prefWidth="200.0" text="Tên sản phẩm"/>
                        <TableColumn fx:id="colPrice"      prefWidth="120.0" text="Giá khởi điểm"/>
                        <TableColumn fx:id="colHighestBid" prefWidth="120.0" text="Giá cao nhất"/>
                        <TableColumn fx:id="colStatus"     prefWidth="120.0" text="Trạng thái"/>
                        <TableColumn fx:id="colAction"     prefWidth="110.0" text="Thao tác"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>

    </children>
</VBox>
