<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="750.0" spacing="0"
      style="-fx-background-color: #f5f6fa;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.UserController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" prefHeight="55.0" spacing="10.0"
          style="-fx-background-color: #2f3640; -fx-padding: 0 20 0 20;">
        <children>
            <Label text="🏆 ĐẤU GIÁ UET" textFill="white">
                <font><Font name="System Bold" size="18.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeLabel" text="Xin chào!" textFill="#dcdde1">
                <font><Font size="13.0"/></font>
            </Label>
            <Button mnemonicParsing="false" onAction="#onRefreshButtonClick"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
                    text="🔄 Làm mới"/>
            <Button mnemonicParsing="false" onAction="#onLogoutButtonClick"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;"
                    text="Đăng xuất"/>
        </children>
    </HBox>

    <!-- THANH TÌM KIẾM -->
    <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 12 15 12 15;">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <!-- SỬA: Ô tìm kiếm giờ filter real-time qua txtSearch.textProperty listener -->
                <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="400.0"
                           promptText="Tìm kiếm sản phẩm đấu giá..."
                           style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #dcdde1;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Số dư: " textFill="#27ae60">
                    <font><Font name="System Bold" size="13.0"/></font>
                </Label>
                <Label fx:id="lblBalance" text="—" textFill="#27ae60">
                    <font><Font size="13.0"/></font>
                </Label>
            </children>
        </HBox>

        <!-- DANH MỤC — SỬA: thêm onAction để filter hoạt động -->
        <HBox spacing="8.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onFilterAll"
                        style="-fx-background-color: #2f3640; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand;"
                        text="Tất cả"/>
                <Button mnemonicParsing="false" onAction="#onFilterElectronics"
                        style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 15; -fx-background-radius: 15; -fx-cursor: hand;"
                        text="Đồ điện tử"/>
                <Button mnemonicParsing="false" onAction="#onFilterFashion"
                        style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 15; -fx-background-radius: 15; -fx-cursor: hand;"
                        text="Thời trang"/>
                <Button mnemonicParsing="false" onAction="#onFilterAntiques"
                        style="-fx-background-color: white; -fx-border-color: #bdc3c7; -fx-border-radius: 15; -fx-background-radius: 15; -fx-cursor: hand;"
                        text="Đồ cổ"/>
            </children>
        </HBox>
    </VBox>

    <!-- DANH SÁCH SẢN PHẨM -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <content>
            <FlowPane fx:id="productContainer" hgap="20.0" prefWrapLength="700.0" vgap="20.0">
                <padding>
                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
                </padding>
            </FlowPane>
        </content>
    </ScrollPane>
</VBox>
