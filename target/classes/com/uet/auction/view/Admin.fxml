<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainBorderPane" stylesheets="@../style/style.css"
            prefHeight="750.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uet.auction.client.controller.AdminController">

    <top>
        <HBox styleClass="top-header" alignment="CENTER_LEFT" spacing="15">
            <Label text="ĐẤU GIÁ TRỰC TUYẾN UET" styleClass="header-logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblAdminName" text="Hệ thống Admin" styleClass="greeting-text"/>
            <Button text="🔄 Làm mới" styleClass="btn-refresh" onAction="#onRefreshButtonClick"/>
            <Button text="Đăng xuất"   styleClass="btn-logout"  onAction="#onLogoutButtonClick"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar" prefWidth="220.0">
            <VBox styleClass="role-balance-box" spacing="5">
                <HBox spacing="5">
                    <Label text="Vai trò:" styleClass="text-grey"/>
                    <Label text="Admin" styleClass="role-text" style="-fx-text-fill: #e74c3c;"/>
                </HBox>
                <HBox spacing="5">
                    <Label text="Số dư:" styleClass="text-grey"/>
                    <Label text="Vô cực" styleClass="balance-text"/>
                </HBox>
            </VBox>
            <VBox spacing="3" style="-fx-padding: 10 15;">
                <HBox spacing="8">
                    <Label text="⏳ Chờ duyệt:" styleClass="text-grey"/>
                    <Label fx:id="lblCountPending" text="0" style="-fx-font-weight: bold; -fx-text-fill: #e67e22;"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="🔥 Đang đấu:"   styleClass="text-grey"/>
                    <Label fx:id="lblCountOpen"    text="0" style="-fx-font-weight: bold; -fx-text-fill: #2980b9;"/>
                </HBox>
                <HBox spacing="8">
                    <Label text="🔒 Đã đóng:"    styleClass="text-grey"/>
                    <Label fx:id="lblCountClosed"  text="0" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
                </HBox>
            </VBox>
            <Button text="Trang chủ"         styleClass="menu-button"                   maxWidth="Infinity"
                    onAction="#onRefreshButtonClick"/>
            <Button text="Duyệt sản phẩm"   styleClass="menu-button, menu-button-active" maxWidth="Infinity"
                    onAction="#onRefreshButtonClick"/>
            <Button text="Quản lý người dùng" styleClass="menu-button"                  maxWidth="Infinity"/>
            <Button text="Hồ sơ cá nhân"         styleClass="menu-button" maxWidth="Infinity"
                    onAction="#onProfileButtonClick"/>
        </VBox>
    </left>

    <center>
    </center>
</BorderPane>