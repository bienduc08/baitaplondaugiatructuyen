<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.ProfileController"
      style="-fx-background-color: #f0f4f8;">

    <!-- HEADER -->
    <HBox prefHeight="140.0"
          style="-fx-background-color: linear-gradient(to right, #4a148c, #6a1b9a, #7b1fa2);
                 -fx-padding: 30 36 30 36;"
          alignment="CENTER_LEFT" spacing="22.0">
        <StackPane>
            <Circle radius="50.0" style="-fx-fill: rgba(255,255,255,0.15); -fx-stroke: rgba(255,255,255,0.4); -fx-stroke-width: 2;"/>
            <Label text="👤" style="-fx-font-size: 28;"/>
        </StackPane>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label fx:id="lblUsername" text="Người dùng" textFill="white"
                   style="-fx-font-size: 24; -fx-font-weight: bold;"/>
            <Label fx:id="lblRole" text="👤 Người dùng"
                   style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white;
                          -fx-font-size: 12; -fx-font-weight: bold;
                          -fx-padding: 4 16; -fx-background-radius: 20;"/>
        </VBox>
        <VBox spacing="6.0" alignment="CENTER_RIGHT">
            <Label fx:id="lblHeaderName" text="👤 Người dùng"
                   style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <Label fx:id="lblHeaderEmail" text="✉ user@gmail.com"
                   style="-fx-text-fill: #e3f2fd; -fx-font-size: 12;"/>
        </VBox>
    </HBox>

    <!-- BODY -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="20.0" style="-fx-padding: 28 32 32 32; -fx-background-color: #f0f4f8;">

            <!-- STATS ROW -->
            <HBox spacing="16.0">
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),12,0,0,4);">
                    <Label text="💰  SỐ DƯ" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #90a4ae;"/>
                    <Label fx:id="lblBalance" text="0 VNĐ"
                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #6a1b9a;"/>
                    <Label text="Khả dụng để đặt cọc đấu giá" style="-fx-font-size: 11; -fx-text-fill: #cfd8dc;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),12,0,0,4);">
                    <Label text="🏷  ĐẤU GIÁ" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #90a4ae;"/>
                    <Label fx:id="lblTotalBids" text="0"
                           style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #4a148c;"/>
                    <Label text="Lần đặt giá" style="-fx-font-size: 11; -fx-text-fill: #cfd8dc;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: white; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),12,0,0,4);">
                    <Label text="🔖  TRẠNG THÁI" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #90a4ae;"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Circle radius="7.0" style="-fx-fill: #43a047;"/>
                        <Label text="Đang hoạt động"
                               style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                    </HBox>
                    <Label text="Tài khoản hợp lệ" style="-fx-font-size: 11; -fx-text-fill: #cfd8dc;"/>
                </VBox>
            </HBox>

            <!-- LỊCH SỬ GIAO DỊCH -->
            <VBox spacing="14.0" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 16;
                         -fx-padding: 24 28; -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.07),12,0,0,4);">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="💸" style="-fx-font-size: 20;"/>
                    <VBox spacing="2.0">
                        <Label text="Lịch sử giao dịch"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #4a148c;"/>
                        <Label text="Các giao dịch mua và đặt cọc đấu giá gần đây"
                               style="-fx-font-size: 11; -fx-text-fill: #b0bec5;"/>
                    </VBox>
                </HBox>
                <Separator/>
                <TableView fx:id="tblMyBids" VBox.vgrow="ALWAYS" prefHeight="300.0"
                           style="-fx-background-color: transparent; -fx-border-color: #ede7f6;
                                  -fx-border-radius: 8; -fx-border-width: 1;">
                    <columns>
                        <TableColumn fx:id="colProduct" prefWidth="260.0" text="Sản phẩm"/>
                        <TableColumn fx:id="colAmount"  prefWidth="170.0" text="Số tiền"/>
                        <TableColumn fx:id="colTime"    prefWidth="190.0" text="Thời gian"/>
                        <TableColumn fx:id="colStatus"  prefWidth="120.0" text="Kết quả"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 40;">
                            <Label text="📭" style="-fx-font-size: 32;"/>
                            <Label text="Chưa có giao dịch nào"
                                   style="-fx-font-size: 13; -fx-text-fill: #90a4ae;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
