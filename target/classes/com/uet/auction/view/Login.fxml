<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="550.0" prefWidth="800.0" style="-fx-background-color: #f5f6fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.LoginController">
   <children>
      <VBox alignment="CENTER" maxWidth="400.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>
         <children>
            <ImageView fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../images/Logo_HUET.svg.png" />
               </image>
            </ImageView>

            <VBox alignment="CENTER" spacing="5.0" />
            <Label prefHeight="61.0" prefWidth="183.0" text="Phần mềm đấu giá trực tuyến" textFill="#7f8c8d">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>

            <Separator prefWidth="200.0" />

            <VBox spacing="15.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Tên đăng nhập" textFill="#353b48">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <TextField fx:id="usernameField" prefHeight="40.0" promptText="Username" style="-fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Mật khẩu" textFill="#353b48">
                           <font>
                              <Font name="System Bold" size="13.0" />
                           </font>
                        </Label>
                        <PasswordField fx:id="passwordField" prefHeight="40.0" promptText="Password" style="-fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
               </children>
            </VBox>

            <Button fx:id="loginButton" maxWidth="1.7976931348623157E308" onAction="#handleLoginButton" prefHeight="45.0" style="-fx-background-color: #2f3640; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="ĐĂNG NHẬP">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Button>

            <HBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="Bạn là thành viên mới?" />
                  <Hyperlink onAction="#handleRegisterButton" text="Đăng ký đấu giá" textFill="#e1b12c" />
               </children>
            </HBox>

            <Label fx:id="statusLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" textFill="#e84118" wrapText="true" />
         </children>
      </VBox>
   </children>
</StackPane>
