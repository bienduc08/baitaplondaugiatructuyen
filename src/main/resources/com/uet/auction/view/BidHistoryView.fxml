<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uet.auction.client.controller.BidHistoryController">
    <children>
        <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="LỊCH SỬ ĐẤU GIÁ" textFill="#2980b9">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Separator orientation="VERTICAL" />
                        <Label fx:id="productNameLabel" text="Tên sản phẩm: [Đang tải...]" textFill="#7f8c8d">
                            <font>
                                <Font name="System Italic" size="14.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <TableView fx:id="bidHistoryTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="timeCol" prefWidth="180.0" text="Thời gian" />
                        <TableColumn fx:id="userCol" prefWidth="200.0" text="Người trả giá" />
                        <TableColumn fx:id="priceCol" prefWidth="150.0" text="Số tiền (VNĐ)" />
                        <TableColumn fx:id="statusCol" prefWidth="130.0" text="Trạng thái" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label fx:id="totalBidsLabel" text="Tổng cộng: 0 lượt trả giá" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onRefreshClick" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Làm mới" />
                        <Button mnemonicParsing="false" onAction="#onCloseClick" prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Đóng" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>