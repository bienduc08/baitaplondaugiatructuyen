<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="580.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.uet.auction.client.controller.BidHistoryController">
    <children>
        <VBox spacing="12.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>

                <!-- Tiêu đề -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label text="LỊCH SỬ ĐẤU GIÁ" textFill="#2980b9">
                            <font><Font name="System Bold" size="20.0" /></font>
                        </Label>
                        <Separator orientation="VERTICAL" />
                        <Label fx:id="productNameLabel" text="Tên sản phẩm: [Đang tải...]" textFill="#7f8c8d">
                            <font><Font name="System Italic" size="14.0" /></font>
                        </Label>
                    </children>
                </HBox>

                <!-- TabPane: Bảng + Biểu đồ -->
                <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <tabs>

                        <!-- Tab 1: Bảng lịch sử -->
                        <Tab text="📋  Bảng lịch sử">
                            <content>
                                <TableView fx:id="bidHistoryTable" style="-fx-padding: 5;">
                                    <columns>
                                        <TableColumn fx:id="timeCol"   prefWidth="185.0" text="Thời gian" />
                                        <TableColumn fx:id="bidderCol" prefWidth="200.0" text="Người trả giá" />
                                        <TableColumn fx:id="priceCol"  prefWidth="155.0" text="Số tiền (VNĐ)" />
                                        <TableColumn fx:id="statusCol" prefWidth="130.0" text="Trạng thái" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </content>
                        </Tab>

                        <!-- Tab 2: Biểu đồ diễn biến giá -->
                        <Tab text="📈  Biểu đồ giá">
                            <content>
                                <VBox spacing="8.0" style="-fx-padding: 10; -fx-background-color: #f8fafc;">
                                    <children>
                                        <Label text="Diễn biến giá đấu theo thời gian" textFill="#2980b9" style="-fx-font-weight: bold; -fx-font-size: 13;">
                                        </Label>
                                        <LineChart fx:id="bidLineChart" VBox.vgrow="ALWAYS"
                                                   style="-fx-background-color: white; -fx-background-radius: 10;">
                                            <xAxis>
                                                <CategoryAxis fx:id="xAxis" label="Lượt đặt giá" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis fx:id="yAxis" label="Giá (VNĐ)" />
                                            </yAxis>
                                        </LineChart>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                    </tabs>
                </TabPane>

                <!-- Footer -->
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <children>
                        <Label fx:id="totalBidsLabel" text="Tổng cộng: 0 lượt trả giá" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#onRefreshClick" prefHeight="30.0" prefWidth="100.0"
                                style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Làm mới" />
                        <Button mnemonicParsing="false" onAction="#onCloseClick" prefHeight="30.0" prefWidth="100.0"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Đóng" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
