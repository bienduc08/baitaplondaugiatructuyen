<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.ProfileAdminController"
      style="-fx-background-color: #0f172a;">

    <!-- HEADER -->
    <HBox prefHeight="150.0"
          style="-fx-background-color: linear-gradient(to right, #0f172a, #1e3a5f, #1565c0);
                 -fx-padding: 30 36 30 36; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_LEFT" spacing="22.0">
        <StackPane>
            <Circle radius="52.0" style="-fx-fill: linear-gradient(to bottom right, #1565c0, #0d47a1);
                     -fx-stroke: #42a5f5; -fx-stroke-width: 2.5;"/>
            <Label text="🛡" style="-fx-font-size: 32;"/>
        </StackPane>
        <VBox spacing="8.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
            <Label fx:id="lblUsername" text="Admin" textFill="white"
                   style="-fx-font-size: 26; -fx-font-weight: bold;"/>
            <Label fx:id="lblRole" text="🛡 Quản trị viên"
                   style="-fx-background-color: rgba(21,101,192,0.6); -fx-text-fill: #90caf9;
                          -fx-font-size: 12; -fx-font-weight: bold;
                          -fx-padding: 4 16; -fx-background-radius: 20;"/>
        </VBox>
        <VBox spacing="6.0" alignment="CENTER_RIGHT">
            <Label fx:id="lblHeaderName" text="👤 Admin"
                   style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
            <Label fx:id="lblHeaderEmail" text="✉ admin@gmail.com"
                   style="-fx-text-fill: #86efac; -fx-font-size: 12;"/>
            <Label fx:id="lblHeaderPhoneNumber" style="-fx-text-fill: #86efac; -fx-font-size: 12;"  text="📞 SĐT" />
            <Button onAction="#onEditProfileClick"
                    style="-fx-background-color: rgba(144, 202, 249, 0.1); -fx-border-color: #90caf9; -fx-border-radius: 12; -fx-background-radius: 12; -fx-text-fill: #90caf9; -fx-font-size: 11; -fx-font-weight: bold; -fx-padding: 4 15; -fx-cursor: hand;"
                    text="✏ Chỉnh sửa hồ sơ" />
        </VBox>
    </HBox>

    <!-- BODY -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
        <VBox spacing="20.0" style="-fx-padding: 28 32 32 32; -fx-background-color: #0f172a;">

            <!-- STATS ROW -->
            <HBox spacing="16.0">
                <!-- Balance -->
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: #1e293b; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-border-color: #334155; -fx-border-radius: 16; -fx-border-width: 1;
                             -fx-effect: dropshadow(three-pass-box,rgba(21,101,192,0.3),16,0,0,4);">
                    <Label text="💰  SỐ DƯ" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Label fx:id="lblBalance" text="0 VNĐ"
                           style="-fx-font-size: 26; -fx-font-weight: bold;
                                  -fx-text-fill: linear-gradient(to right,#42a5f5,#1e88e5);"/>
                    <Label text="Số dư hiện tại" style="-fx-font-size: 11; -fx-text-fill: #475569;"/>
                    <Button onAction="#onDepositClick" text="💳  Nạp tiền"
                            style="-fx-background-color: linear-gradient(to right,#1565c0,#0d47a1);
                                   -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;
                                   -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 8 16;"/>
                </VBox>
                <!-- Quyền hạn -->
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: #1e293b; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-border-color: #334155; -fx-border-radius: 16; -fx-border-width: 1;
                             -fx-effect: dropshadow(three-pass-box,rgba(124,58,237,0.3),16,0,0,4);">
                    <Label text="🔐  QUYỀN HẠN" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Label text="Toàn quyền"
                           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #a78bfa;"/>
                    <Label text="Duyệt SP · Quản lý người dùng · Xem báo cáo"
                           style="-fx-font-size: 11; -fx-text-fill: #475569;"/>
                </VBox>
                <!-- Trạng thái -->
                <VBox HBox.hgrow="ALWAYS" spacing="10.0"
                      style="-fx-background-color: #1e293b; -fx-background-radius: 16;
                             -fx-padding: 24 26; -fx-border-color: #334155; -fx-border-radius: 16; -fx-border-width: 1;
                             -fx-effect: dropshadow(three-pass-box,rgba(16,185,129,0.3),16,0,0,4);">
                    <Label text="🔖  TRẠNG THÁI" style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Circle radius="7.0" style="-fx-fill: #10b981;"/>
                        <Label text="Đang hoạt động"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>
                    </HBox>
                    <Label fx:id="lblSystemStatus" text="🟢 Hệ thống bình thường"
                           style="-fx-font-size: 11; -fx-text-fill: #475569;"/>
                </VBox>
            </HBox>

            <!-- CHỨC NĂNG QUẢN TRỊ -->
            <VBox spacing="14.0"
                  style="-fx-background-color: #1e293b; -fx-background-radius: 16;
                         -fx-padding: 26 28; -fx-border-color: #334155; -fx-border-radius: 16; -fx-border-width: 1;
                         -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.4),12,0,0,4);">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="⚙️" style="-fx-font-size: 20;"/>
                    <VBox spacing="2.0">
                        <Label text="Chức năng quản trị"
                               style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                        <Label text="Các quyền hạn dành riêng cho tài khoản Admin"
                               style="-fx-font-size: 11; -fx-text-fill: #64748b;"/>
                    </VBox>
                </HBox>
                <Separator style="-fx-background-color: #334155;"/>
                <GridPane hgap="14.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="33.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="34.0"/>
                    </columnConstraints>
                    <!-- Card 1: Duyệt SP -->
                    <VBox GridPane.columnIndex="0" spacing="10.0"
                          style="-fx-background-color: linear-gradient(to bottom right,#1e3a5f,#1a2f4a);
                                 -fx-background-radius: 14; -fx-padding: 20 22;
                                 -fx-border-color: #1e40af; -fx-border-radius: 14; -fx-border-width: 1;">
                        <Label text="📦" style="-fx-font-size: 28;"/>
                        <Label text="Duyệt sản phẩm"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #93c5fd;"/>
                        <Label text="Xét duyệt và phê duyệt sản phẩm đấu giá từ người bán"
                               style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-wrap-text: true;"/>
                    </VBox>
                    <!-- Card 2: Quản lý ND -->
                    <VBox GridPane.columnIndex="1" spacing="10.0"
                          style="-fx-background-color: linear-gradient(to bottom right,#3b0764,#2e1065);
                                 -fx-background-radius: 14; -fx-padding: 20 22;
                                 -fx-border-color: #7e22ce; -fx-border-radius: 14; -fx-border-width: 1;">
                        <Label text="👥" style="-fx-font-size: 28;"/>
                        <Label text="Quản lý người dùng"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;"/>
                        <Label text="Khoá, mở khoá và quản lý toàn bộ tài khoản trong hệ thống"
                               style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-wrap-text: true;"/>
                    </VBox>
                    <!-- Card 3: Theo dõi -->
                    <VBox GridPane.columnIndex="2" spacing="10.0"
                          style="-fx-background-color: linear-gradient(to bottom right,#052e16,#064e3b);
                                 -fx-background-radius: 14; -fx-padding: 20 22;
                                 -fx-border-color: #065f46; -fx-border-radius: 14; -fx-border-width: 1;">
                        <Label text="📊" style="-fx-font-size: 28;"/>
                        <Label text="Theo dõi hệ thống"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #6ee7b7;"/>
                        <Label text="Xem báo cáo tổng quan về hoạt động đấu giá toàn hệ thống"
                               style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-wrap-text: true;"/>
                    </VBox>
                </GridPane>
            </VBox>

            <!-- THÔNG TIN HỆ THỐNG -->
            <VBox spacing="14.0"
                  style="-fx-background-color: #1e293b; -fx-background-radius: 16;
                         -fx-padding: 26 28; -fx-border-color: #334155; -fx-border-radius: 16; -fx-border-width: 1;">
                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="🖥️" style="-fx-font-size: 20;"/>
                    <Label text="Thông tin hệ thống"
                           style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
                </HBox>
                <Separator style="-fx-background-color: #334155;"/>
                <HBox spacing="20.0">
                    <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                          style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-padding: 16;">
                        <Label text="🌐  Nền tảng" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                        <Label text="JavaFX · Socket TCP/IP"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                          style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-padding: 16;">
                        <Label text="🗄️  Cơ sở dữ liệu" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                        <Label text="PostgreSQL · JDBC"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                    <VBox HBox.hgrow="ALWAYS" spacing="8.0"
                          style="-fx-background-color: #0f172a; -fx-background-radius: 10; -fx-padding: 16;">
                        <Label fx:id="lblCurrentTime" text="🕐 --/--/---- --:--"
                               style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-font-weight: bold;"/>
                        <Label text="Thời gian hiện tại"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #94a3b8;"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
