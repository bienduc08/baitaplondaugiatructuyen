<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox style="-fx-background-color: #1a0533;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.ProfileUserController">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" prefHeight="150.0" spacing="22.0" style="-fx-background-color: linear-gradient(to right, #1a0533, #3b0764, #6d28d9);                  -fx-padding: 30 36 30 36; -fx-border-color: #5b21b6; -fx-border-width: 0 0 1 0;">
        <StackPane>
            <Circle radius="52.0" style="-fx-fill: linear-gradient(to bottom right,#6d28d9,#4c1d95);                      -fx-stroke: #a78bfa; -fx-stroke-width: 2.5;" />
            <Label style="-fx-font-size: 30;" text="👤" />
        </StackPane>
        <VBox alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS">
            <Label fx:id="lblUsername" style="-fx-font-size: 26; -fx-font-weight: bold;" text="Người dùng" textFill="white" />
            <Label fx:id="lblRole" style="-fx-background-color: rgba(109,40,217,0.6); -fx-text-fill: #c4b5fd;                           -fx-font-size: 12; -fx-font-weight: bold;                           -fx-padding: 4 16; -fx-background-radius: 20;" text="👤 Người dùng" />
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="6.0">
            <Label fx:id="lblHeaderName" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;" text="👤 Người dùng" />
            <Label fx:id="lblHeaderEmail" style="-fx-text-fill: #c4b5fd; -fx-font-size: 12;" text="✉ user@gmail.com" />
        </VBox>
    </HBox>

    <!-- BODY -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="20.0" style="-fx-padding: 28 32 32 32; -fx-background-color: #1a0533;">

            <!-- STATS ROW -->
            <HBox spacing="16.0">
                <VBox spacing="10.0" style="-fx-background-color: #2e1065; -fx-background-radius: 16;                              -fx-padding: 24 26; -fx-border-color: #5b21b6; -fx-border-radius: 16; -fx-border-width: 1;                              -fx-effect: dropshadow(three-pass-box,rgba(167,139,250,0.3),16,0,0,4);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6d28d9;" text="💰  SỐ DƯ" />
                    <Label fx:id="lblBalance" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #a78bfa;" text="0 VNĐ" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #374151;" text="Khả dụng để đấu giá" />
                    <Button fx:id="btnDeposit" onAction="#onDepositClick" style="-fx-background-color: linear-gradient(to right,#6d28d9,#5b21b6);                                    -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;                                    -fx-cursor: hand; -fx-font-size: 12; -fx-padding: 8 16;" text="💳  Nạp tiền" />
                </VBox>
                <VBox spacing="10.0" style="-fx-background-color: #2e1065; -fx-background-radius: 16;                              -fx-padding: 24 26; -fx-border-color: #5b21b6; -fx-border-radius: 16; -fx-border-width: 1;                              -fx-effect: dropshadow(three-pass-box,rgba(251,146,60,0.2),16,0,0,4);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6d28d9;" text="🏷  TỔNG ĐẤU GIÁ" />
                    <Label fx:id="lblTotalBids" style="-fx-font-size: 34; -fx-font-weight: bold; -fx-text-fill: #fb923c;" text="0" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #374151;" text="Lần đặt giá" />
                </VBox>
                <VBox spacing="10.0" style="-fx-background-color: #2e1065; -fx-background-radius: 16;                              -fx-padding: 24 26; -fx-border-color: #5b21b6; -fx-border-radius: 16; -fx-border-width: 1;                              -fx-effect: dropshadow(three-pass-box,rgba(16,185,129,0.2),16,0,0,4);" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 10; -fx-font-weight: bold; -fx-text-fill: #6d28d9;" text="🔖  TRẠNG THÁI" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Circle radius="7.0" style="-fx-fill: #10b981;" />
                        <Label style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #10b981;" text="Đang hoạt động" />
                    </HBox>
                    <Label style="-fx-font-size: 11; -fx-text-fill: #374151;" text="Tài khoản hợp lệ" />
                </VBox>
            </HBox>

            <!-- LỊCH SỬ ĐẤU GIÁ - có thể cuộn bằng con lăn chuột -->
            <VBox spacing="14.0" style="-fx-background-color: #2e1065; -fx-background-radius: 16;                          -fx-padding: 24 28; -fx-border-color: #5b21b6; -fx-border-radius: 16; -fx-border-width: 1;                          -fx-effect: dropshadow(three-pass-box,rgba(0,0,0,0.5),12,0,0,4);" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label style="-fx-font-size: 20;" text="💸" />
                    <VBox spacing="2.0">
                        <Label style="-fx-font-size: 15; -fx-font-weight: bold; -fx-text-fill: #c4b5fd;" text="Lịch sử đấu giá gần đây" />
                        <Label style="-fx-font-size: 11; -fx-text-fill: #6d28d9;" text="Các lần đặt giá và kết quả tham gia đấu giá của bạn" />
                    </VBox>
                </HBox>
                <Separator style="-fx-background-color: #5b21b6;" />
                <TableView fx:id="tblMyBids" prefHeight="360.0" style="-fx-background-color: transparent; -fx-border-color: #5b21b6;                                   -fx-border-radius: 8; -fx-border-width: 1; -fx-table-cell-border-color: #3b1c7a;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProduct" prefWidth="260.0" text="Sản phẩm" />
                        <TableColumn fx:id="colAmount" prefWidth="170.0" text="Số tiền" />
                        <TableColumn fx:id="colTime" prefWidth="190.0" text="Thời gian" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Kết quả" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="10.0" style="-fx-padding: 40;">
                            <Label style="-fx-font-size: 32;" text="📭" />
                            <Label style="-fx-font-size: 13; -fx-text-fill: #6d28d9;" text="Chưa có giao dịch nào" />
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
