<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="700.0" prefWidth="900.0" spacing="20.0" style="-fx-padding: 30; -fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.UserAuctionsController">
    <children>
        <VBox spacing="5.0">
            <children>
                <Label text="Phiên đấu giá đã tham gia" textFill="#2c3e50">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Label>
                <Label text="Theo dõi các sản phẩm bạn đang cạnh tranh hoặc đã chiến thắng." textFill="#7f8c8d">
                    <font><Font size="14.0" /></font>
                </Label>
            </children>
        </VBox>

        <VBox VBox.vgrow="ALWAYS" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <children>
                <TableView fx:id="tblJoinedAuctions" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" text="Mã SP" />
                        <TableColumn fx:id="colName" prefWidth="250.0" text="Tên sản phẩm" />
                        <TableColumn fx:id="colCurrentPrice" prefWidth="150.0" text="Giá hiện tại (Đỉnh)" />
                        <TableColumn fx:id="colOwner" prefWidth="150.0" text="Người giữ đỉnh" />
                        <TableColumn fx:id="colEndTime" prefWidth="160.0" text="Hạn kết thúc" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng thái" />
                        <TableColumn fx:id="colAction" prefWidth="100.0" text="Thao tác" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>