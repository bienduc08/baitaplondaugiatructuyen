<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20;" stylesheets="@../style/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.NotificationListController">

    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 0 0 10 0; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
        <Button onAction="#onBackClick" text="⬅ Quay lại" style="-fx-cursor: hand; -fx-font-weight: bold;" />
        <Label text="DANH SÁCH THÔNG BÁO CHƯA ĐỌC" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" />
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <VBox fx:id="notifContainer" spacing="12" style="-fx-padding: 5;" />
    </ScrollPane>

</VBox>