<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Rectangle?>

<VBox prefWidth="260.0" spacing="12.0"
      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5); -fx-cursor: hand;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.ProductItemController"
      onMouseClicked="#onProductCardClick">

    <children>
        <StackPane style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-overflow: hidden;">
            <children>
                <ImageView fx:id="imgProduct" fitHeight="160.0" fitWidth="230.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/default-product.png" />
                    </image>
                </ImageView>
            </children>
        </StackPane>

        <VBox spacing="4.0">
            <children>
                <Label fx:id="nameLabel" text="Tên sản phẩm đấu giá" wrapText="true" maxHeight="45.0">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
                <Label fx:id="sellerLabel" text="Người bán: minhduc09" textFill="#94a3b8" style="-fx-font-size: 11;" />
            </children>
        </VBox>

        <VBox spacing="2.0">
            <children>
                <Label text="Mức giá hiện tại" textFill="#64748b" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                <Label fx:id="priceLabel" text="50,000,000 VNĐ" textFill="#c67c22">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
            </children>
        </VBox>

        <Separator opacity="0.4" />

        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #fff5f5; -fx-padding: 8 15; -fx-background-radius: 10;">
            <children>
                <Label fx:id="timeLabel" text="Còn lại: 00 Ngày 00:00:00" textFill="#e74c3c">
                    <font><Font name="System Bold" size="13.0" /></font>
                </Label>
            </children>
        </HBox>

        <Button onAction="#onProductCardClick" maxWidth="Infinity" text="THAM GIA ĐẤU GIÁ"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 10 0; -fx-cursor: hand;" />
    </children>
</VBox>