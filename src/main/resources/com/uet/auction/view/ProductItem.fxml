<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="260.0" spacing="12.0"
      style="-fx-background-color: white; -fx-background-radius: 18; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 5);"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.ProductItemController">

    <children>
        <StackPane style="-fx-background-color: #f8fafc; -fx-background-radius: 12; -fx-overflow: hidden;">
            <children>
                <ImageView fx:id="imgProduct" fitHeight="160.0" fitWidth="230.0" pickOnBounds="true" preserveRatio="true"/>
            </children>
        </StackPane>

        <Region VBox.vgrow="ALWAYS" />

        <VBox spacing="4.0" minHeight="120.0" prefHeight="120.0">
            <children>
                <Label fx:id="nameLabel" text="Tên sản phẩm đấu giá" wrapText="true" minHeight="45.0" prefHeight="45.0" maxHeight="45.0">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
                <Label fx:id="sellerLabel" text="Người bán: minhduc09" textFill="#94a3b8" style="-fx-font-size: 11;" />
                <Label fx:id="ownerLabel" text="Đang giữ đỉnh: —" textFill="#64748b" style="-fx-font-size: 11;" />
            </children>
        </VBox>

        <VBox spacing="2.0">
            <children>
                <Label text="Mức giá hiện tại" textFill="#64748b" style="-fx-font-size: 11; -fx-font-weight: bold;" />
                <Label fx:id="priceLabel" text="50,000,000 VNĐ" textFill="#c67c22">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
            </children>
        </VBox>



        <VBox spacing="10.0" alignment="BOTTOM_CENTER"> <children>
            <Separator opacity="0.4" />
            <HBox alignment="CENTER" style="-fx-background-color: #fff5f5; -fx-padding: 8 15; -fx-background-radius: 10;">
                <Label fx:id="timeLabel" text="0 ngày 00:00:00"
                       minWidth="180.0" alignment="CENTER"
                       style="-fx-font-family: 'Courier New'; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
            </HBox>
            <Button onAction="#onProductCardClick" maxWidth="Infinity" text="THAM GIA ĐẤU GIÁ"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" />
        </children>
        </VBox>
    </children>
</VBox>