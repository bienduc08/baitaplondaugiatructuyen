<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="220.0" spacing="8.0"
      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.ProductItemController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <!-- Ảnh sản phẩm -->
        <VBox alignment="CENTER" prefHeight="120.0"
              style="-fx-background-color: #f5f6fa; -fx-background-radius: 10;">
            <children>
                <ImageView fx:id="imgProduct" fitHeight="110.0" fitWidth="180.0"
                           pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../images/Logo_HUET.svg.png" /></image>
                </ImageView>
            </children>
        </VBox>

        <!-- Tên sản phẩm -->
        <Label fx:id="nameLabel" text="Tên sản phẩm" wrapText="true">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>

        <!-- Người bán -->
        <Label fx:id="sellerLabel" text="Người bán: —" textFill="#7f8c8d">
            <font><Font size="11.0" /></font>
        </Label>
        <Label fx:id="descriptionLabel" text="" textFill="#555555" wrapText="true" maxHeight="40.0">
            <font><Font size="11.0" /></font>
        </Label>

        <!-- Người giữ đỉnh -->
        <Label fx:id="ownerLabel" text="Đang giữ đỉnh: Chưa có ai" textFill="#27ae60">
            <font><Font size="11.0" /></font>
        </Label>

        <!-- Giá hiện tại -->
        <Label text="Giá hiện tại:" textFill="#7f8c8d">
            <font><Font size="12.0" /></font>
        </Label>
        <Label fx:id="priceLabel" text="0 đ" textFill="#e67e22">
            <font><Font name="System Bold" size="16.0" /></font>
        </Label>

        <!-- Hạn kết thúc -->
        <Label fx:id="timeLabel" text="Hết hạn: —" textFill="#e74c3c">
            <font><Font size="11.0" /></font>
        </Label>

        <!-- Ô nhập giá và nút đấu giá -->
        <TextField fx:id="bidInput" promptText="Nhập giá của bạn..." />
        <Button fx:id="btnBid" maxWidth="Infinity" mnemonicParsing="false"
                onAction="#onBidButtonClick"
                prefHeight="35.0"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                text="Đấu giá ngay" />
        <Button maxWidth="Infinity" mnemonicParsing="false"
                onAction="#onViewHistoryClick"
                prefHeight="30.0"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 8; -fx-cursor: hand;"
                text="Xem lịch sử" />

    </children>
</VBox>