<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.RegisterController">
    <children>
        <StackPane prefWidth="740.0" HBox.hgrow="ALWAYS">
            <children>
                <ImageView fitHeight="720.0" fitWidth="740.0" pickOnBounds="true" preserveRatio="false">
                    <image>
                        <Image url="@../images/Anhbia.png" />
                    </image>
                </ImageView>
            </children>
        </StackPane>

        <VBox alignment="CENTER" prefWidth="540.0" style="-fx-background-color: #f1f5f9;">
            <children>
                <VBox maxWidth="420.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 35 50; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
                    <children>
                        <VBox alignment="CENTER" spacing="10.0">
                            <children>
                                <ImageView fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/Logo_UET.svg.png" />
                                    </image>
                                </ImageView>
                                <Label style="-fx-font-weight: bold;" text="Đăng ký tài khoản" textFill="#1e293b">
                                    <font><Font size="22.0" /></font>
                                </Label>
                            </children>
                        </VBox>

                        <VBox spacing="12.0">
                            <children>
                                <TextField fx:id="fullNameField" prefHeight="45.0" promptText="Họ và tên" style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 0 15;" />
                                <TextField fx:id="gmailField" prefHeight="45.0" promptText="Gmail" style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 0 15;"  />
                                <TextField fx:id="usernameField" prefHeight="45.0" promptText="Tên đăng nhập" style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 0 15;" />

                                <PasswordField fx:id="passwordField" prefHeight="45.0" promptText="Mật khẩu" style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 0 15;" />
                                <PasswordField fx:id="confirmPasswordField" prefHeight="45.0" promptText="Nhập lại mật khẩu" style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 0 15;" />

                                <ComboBox fx:id="roleComboBox" maxWidth="Infinity" prefHeight="45.0" promptText="Chọn vai trò" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10;" />

                                <Label fx:id="statusLabel" style="-fx-font-size: 12;" textFill="RED" wrapText="true" />
                            </children>
                        </VBox>

                        <VBox spacing="15.0">
                            <children>
                                <Button fx:id="btnRegister" maxWidth="Infinity" onAction="#handleRegisterAction" prefHeight="50.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-background-radius: 10; -fx-cursor: hand;" text="ĐĂNG KÝ NGAY" />
                                <HBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Label text="Đã có tài khoản?" textFill="#64748b" />
                                        <Button onAction="#backToLogin" style="-fx-background-color: transparent; -fx-text-fill: #3b82f6; -fx-cursor: hand; -fx-padding: 0; -fx-font-weight: bold;" text="Đăng nhập ngay" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</HBox>
