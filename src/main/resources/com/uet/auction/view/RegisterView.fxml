<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" prefHeight="500.0" prefWidth="400.0"
      xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.RegisterController">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="ĐĂNG KÝ TÀI KHOẢN">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <GridPane vgap="10" hgap="10" alignment="CENTER">
        <Label text="Họ tên:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fullNameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Tên đăng nhập:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="usernameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Mật khẩu:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <PasswordField fx:id="passwordField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Xác nhận mật khẩu:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <PasswordField fx:id="confirmPasswordField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Vai trò:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="roleComboBox" prefWidth="150.0" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Đăng ký ngay" onAction="#handleRegisterAction"
            style="-fx-background-color: #3498db; -fx-text-fill: white;" prefWidth="200"/>

    <Hyperlink text="Đã có tài khoản? Đăng nhập" onAction="#backToLogin"/>

    <Label fx:id="statusLabel" textFill="RED" />

</VBox>