<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.Cursor?>

<ScrollPane fitToWidth="true" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.ProfileEditController">
    <content>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: #f8fafc; -fx-padding: 30 20; -fx-font-family: 'Segoe UI', Helvetica, Arial, sans-serif;">
            <children>

                <HBox alignment="CENTER_LEFT" maxWidth="750.0">
                    <children>
                        <Button onAction="#onCancel" style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-size: 15px; -fx-font-weight: bold; -fx-padding: 5 10;" text="⬅ Quay lại">
                            <cursor>
                                <Cursor fx:constant="HAND" />
                            </cursor>
                        </Button>
                    </children>
                </HBox>

                <VBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label text="Thiết lập tài khoản" textFill="#0f172a">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Quản lý thông tin cá nhân và bảo mật tài khoản của bạn" textFill="#64748b">
                            <font><Font size="14.0" /></font>
                        </Label>
                    </children>
                </VBox>

                <VBox maxWidth="750.0" spacing="35.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 40; -fx-effect: dropshadow(three-pass-box, rgba(149, 157, 165, 0.15), 24, 0, 0, 8); -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1;">
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="25.0">
                            <children>
                                <StackPane style="-fx-background-color: #f1f5f9; -fx-background-radius: 100; -fx-border-color: #e2e8f0; -fx-border-radius: 100; -fx-border-width: 2; -fx-padding: 4;">
                                    <children>
                                        <ImageView fx:id="imgAvatar" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
                                    </children>
                                </StackPane>
                                <VBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Button onAction="#onChangeAvatar" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16; -fx-border-color: #cbd5e1; -fx-border-radius: 8;" text="Thay đổi ảnh đại diện">
                                            <cursor><Cursor fx:constant="HAND" /></cursor>
                                        </Button>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <Separator style="-fx-background-color: transparent; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0;" />

                        <GridPane hgap="25.0" vgap="20.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="SOMETIMES" />
                                <RowConstraints vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <VBox spacing="8.0">
                                    <Label text="Họ và tên" textFill="#334155" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="txtFullName" prefHeight="42.0" style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 0 12;" />
                                </VBox>
                                <VBox spacing="8.0" GridPane.columnIndex="1">
                                    <Label text="Tên đăng nhập" textFill="#334155" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="txtUsername" editable="false" prefHeight="42.0" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-background-color: #f8fafc; -fx-text-fill: #94a3b8; -fx-padding: 0 12;" />
                                </VBox>
                                <VBox spacing="8.0" GridPane.rowIndex="1">
                                    <Label text="Số điện thoại" textFill="#334155" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="txtPhone" prefHeight="42.0" style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 0 12;" />
                                </VBox>
                                <VBox spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Gmail" textFill="#334155" style="-fx-font-weight: bold;"/>
                                    <TextField fx:id="txtEmail"  prefHeight="42.0" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8; -fx-padding: 0 12;" />
                                </VBox>
                            </children>
                        </GridPane>

                        <Separator style="-fx-background-color: transparent; -fx-border-color: #f1f5f9; -fx-border-width: 1 0 0 0;" />

                        <VBox spacing="20.0">
                            <Label text="Đổi mật khẩu" textFill="#0f172a" style="-fx-font-weight: bold;">
                                <font><Font size="18.0" /></font>
                            </Label>
                            <GridPane hgap="25.0" vgap="15.0">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                                </columnConstraints>
                                <rowConstraints>
                                    <RowConstraints vgrow="SOMETIMES" />
                                </rowConstraints>
                                <children>
                                    <VBox spacing="8.0">
                                        <Label text="Mật khẩu hiện tại" textFill="#334155" />
                                        <PasswordField fx:id="txtOldPassword" prefHeight="42.0" style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 0 12;" />
                                    </VBox>
                                    <VBox spacing="8.0" GridPane.columnIndex="1">
                                        <Label text="Mật khẩu mới" textFill="#334155" />
                                        <PasswordField fx:id="txtNewPassword" prefHeight="42.0" style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 0 12;" />
                                    </VBox>
                                </children>
                            </GridPane>
                        </VBox>

                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 10 0 40 0;">
                    <children>
                        <Button onAction="#onSave" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-font-size: 14px; -fx-effect: dropshadow(two-pass-box, rgba(16, 185, 129, 0.4), 10, 0, 0, 4);" text="Lưu thay đổi">
                            <cursor><Cursor fx:constant="HAND" /></cursor>
                        </Button>
                    </children>
                </HBox>

            </children>
        </VBox>
    </content>
</ScrollPane>