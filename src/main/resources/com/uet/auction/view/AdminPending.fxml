<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.AdminPendingController">

    <VBox fx:id="adminContent" spacing="15" style="-fx-padding: 20;" VBox.vgrow="ALWAYS">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="DANH SÁCH SẢN PHẨM CẦN QUẢN LÝ" />

        <TableView fx:id="pendingTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="nameCol" prefWidth="173.0" text="Tên sản phẩm" />
                <TableColumn fx:id="sellerCol" prefWidth="144.0" text="Người bán" />
                <TableColumn fx:id="priceCol" prefWidth="103.0" text="Giá khởi điểm" />
                <TableColumn fx:id="stepCol" prefWidth="89.0" text="Bước giá" />
                <TableColumn fx:id="startTimeCol" prefWidth="193.0" text="Thời gian bắt đầu" />
                <TableColumn fx:id="endTimeCol" prefWidth="180.0" text="Thời gian kết thúc" />
                <TableColumn fx:id="statusCol" prefWidth="150.0" text="Trạng thái" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="15">
            <Button onAction="#onRejectButtonClick" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;" text="✘ Từ chối sản phẩm" />
            <Button onAction="#onApproveButtonClick" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;" text="✓ Duyệt sản phẩm" />
        </HBox>
    </VBox>

</VBox>