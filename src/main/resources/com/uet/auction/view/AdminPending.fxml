<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.AdminPendingController">
    <VBox spacing="5.0">
        <Label text="Quản lý sản phẩm chờ duyệt" textFill="#1e293b">
            <font><Font name="System Bold" size="28.0" /></font>
        </Label>
        <Label text="Xem xét và phê duyệt các sản phẩm được người dùng đăng lên hệ thống UET Auction" textFill="#64748b" />
    </VBox>

    <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);" VBox.vgrow="ALWAYS">
        <!-- FIX: fx:id khớp với AdminPendingController: pendingTable, idCol, nameCol, sellerCol, priceCol, stepCol, startTimeCol, endTimeCol, statusCol -->
        <TableView fx:id="pendingTable" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nameCol" prefWidth="200.0" text="Tên sản phẩm" />
                <TableColumn fx:id="sellerCol" prefWidth="120.0" text="Người bán" />
                <TableColumn fx:id="priceCol" prefWidth="112.0" text="Giá khởi điểm" />
                <TableColumn fx:id="currentCol" prefWidth="83.19998168945312" text="Giá hiện tại" />
                <TableColumn fx:id="stepCol" prefWidth="110.0" text="Bước giá" />
                <TableColumn fx:id="startTimeCol" prefWidth="140.0" text="Bắt đầu" />
                <TableColumn fx:id="endTimeCol" prefWidth="140.0" text="Kết thúc" />
                <TableColumn fx:id="statusCol" prefWidth="110.0" text="Trạng thái" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <!-- FIX: onAction method names khớp với controller: onRejectButtonClick, onApproveButtonClick -->
            <Button onAction="#onRejectButtonClick" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="❌ Từ chối" />
            <Button onAction="#onApproveButtonClick" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="✅ Phê duyệt" />
        </HBox>
    </VBox>
</VBox>
