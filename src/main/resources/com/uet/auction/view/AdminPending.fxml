<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.AdminPendingController">
    <VBox spacing="5.0">
        <Label text="Quản lý sản phẩm chờ duyệt" textFill="#1e293b">
            <font><Font name="System Bold" size="28.0" /></font>
        </Label>
        <Label text="Xem xét và phê duyệt các sản phẩm được người dùng đăng lên hệ thống UET Auction" textFill="#64748b" />
    </VBox>

    <VBox spacing="15.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
        <TableView fx:id="tbvPendingProducts" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="200.0" text="Tên sản phẩm" />
                <TableColumn fx:id="colSeller" prefWidth="120.0" text="Người bán" />
                <TableColumn fx:id="colPrice" prefWidth="120.0" text="Giá khởi điểm" />
                <TableColumn fx:id="colStartTime" prefWidth="150.0" text="Bắt đầu" />
                <TableColumn fx:id="colEndTime" prefWidth="150.0" text="Kết thúc" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>

        <HBox spacing="15.0" alignment="CENTER_RIGHT">
            <Button onAction="#onRejectClick" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="❌ Từ chối" />
            <Button onAction="#onApproveClick" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="✅ Phê duyệt" />
        </HBox>
    </VBox>
</VBox>