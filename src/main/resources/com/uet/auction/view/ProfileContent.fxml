<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="25.0" style="-fx-padding: 30 40 40 40; -fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.ProfileController">
    <children>
        <Button onAction="#onBackButtonClick" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 0 0 10 0;" text="← Quay lại" />

        <HBox spacing="30.0" alignment="CENTER_LEFT">
            <children>
                <StackPane>
                    <Circle radius="55.0" styleClass="avatar-gradient" />
                    <Label fx:id="lblAvatarInitial" text="?" textFill="white" style="-fx-font-size: 40; -fx-font-weight: 900;" />
                </StackPane>
                <VBox spacing="10.0">
                    <children>
                        <Label fx:id="lblUsername" text="BIỆN MINH ĐỨC">
                            <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="lblRole" text="Vai trò : QUẢN TRỊ VIÊN" styleClass="role-pill" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Separator opacity="0.5" />

        <VBox fx:id="sellerUpgradeBox" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 20, 0, 0, 10);">
            <children>
                <Label text="Đăng ký bán hàng" textFill="#94a3b8" style="-fx-font-size: 13; -fx-font-weight: bold;" />
                <Label fx:id="lblSellerUpgradeHint" text="Bạn đang là Người dùng. Có thể đăng ký thêm vai trò Người bán để tạo phiên đấu giá." textFill="#64748b" wrapText="true" style="-fx-font-size: 12;" />
                <Button fx:id="btnBecomeSeller" onAction="#onBecomeSellerClick" text="Đăng ký làm Người bán"
                        style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold;" />
            </children>
        </VBox>

        <HBox spacing="25.0">
            <children>
                <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 20, 0, 0, 10);">
                    <children>
                        <Label text="Tài chính khả dụng" textFill="#94a3b8" style="-fx-font-size: 13; -fx-font-weight: bold;" />
                        <Label fx:id="lblBalance" text="10,000,000 VNĐ" textFill="#0f172a">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Label>
                        <Button fx:id="btnDeposit" onAction="#onDepositClick" text="Nạp thêm tiền" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 10; -fx-cursor: hand;" />
                    </children>
                </VBox>

                <VBox prefWidth="350.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 20, 0, 0, 10);">
                    <children>
                        <Label text="Chỉ số hoạt động" textFill="#94a3b8" style="-fx-font-size: 13; -fx-font-weight: bold;" />
                        <HBox spacing="30.0">
                            <children>
                                <VBox>
                                    <Label fx:id="lblTotalBids" text="0" style="-fx-font-size: 22; -fx-font-weight: bold;" />
                                    <Label text="Lượt đấu" textFill="#64748b" style="-fx-font-size: 12;" />
                                </VBox>
                                <VBox>
                                    <Label fx:id="lblTotalWins" text="0" style="-fx-font-size: 22; -fx-font-weight: bold;" />
                                    <Label text="Phiên tham gia" textFill="#64748b" style="-fx-font-size: 12;" />
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox VBox.vgrow="ALWAYS" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 20, 0, 0, 10);">
            <children>
                <Label text="Lịch sử đấu giá gần đây" style="-fx-font-weight: bold; -fx-font-size: 16;" />
                <TableView fx:id="tblMyBids" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colProduct" prefWidth="300.0" text="Sản phẩm" />
                        <TableColumn fx:id="colAmount" prefWidth="180.0" text="Mức giá" />
                        <TableColumn fx:id="colTime" prefWidth="200.0" text="Thời gian" />
                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Kết quả" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</VBox>