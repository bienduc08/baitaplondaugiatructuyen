<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.ProductDetailController">
    <content>
        <VBox prefWidth="997.0" spacing="25.0" style="-fx-padding: 30; -fx-background-color: #f8fafc;">
            <children>
                <Button onAction="#onBackButtonClick" prefHeight="40.0" prefWidth="160.0" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-cursor: hand; -fx-font-weight: bold;" text="← Quay lại sàn đấu giá" />

                <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox prefWidth="420.0" spacing="20.0">
                            <children>
                                <StackPane style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5); -fx-padding: 15;">
                                    <children>
                                        <ImageView fx:id="imgProduct" fitHeight="280.0" fitWidth="360.0" pickOnBounds="true" preserveRatio="true"/>
                                    </children>
                                </StackPane>

                                <VBox prefWidth="390.0" spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                                    <children>
                                        <VBox spacing="5.0">
                                            <children>
                                                <Label style="-fx-font-size: 12; -fx-font-weight: bold;" text="Mức giá hiện tại" textFill="#64748b" />
                                                <Label fx:id="lblCurrentPrice" text="50,000,000 VNĐ" textFill="#e67e22">
                                                    <font>
                                                        <Font name="System Bold" size="32.0" />
                                                    </font>
                                                </Label>
                                                <HBox alignment="CENTER_LEFT" spacing="5.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 12;" text="Bước giá tối thiểu:" textFill="#94a3b8" />
                                                        <Label fx:id="lblStepPrice" style="-fx-font-weight: bold; -fx-font-size: 12;" text="50,000 VNĐ" textFill="#2ecc71" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <Separator opacity="0.3" />

                                        <VBox spacing="10.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold;" text="Người bán:" textFill="#94a3b8" />
                                                        <Label fx:id="lblSellerName" style="-fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 13;" text="minhduc_uethn" />
                                                    </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label style="-fx-font-size: 13; -fx-font-weight: bold;" text="Đang giữ đỉnh:" textFill="#94a3b8" />
                                                        <Label fx:id="lblTopBidder" style="-fx-text-fill: #1e293b; -fx-font-weight: bold; -fx-font-size: 13;" text="duc_biet_biet" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <Separator opacity="0.3" />

                                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #fff5f5; -fx-padding: 12 15; -fx-background-radius: 12;">
                                            <children>
                                                <Label fx:id="lblTimeRemaining" style="-fx-font-weight: bold; -fx-font-size: 14;" text="Còn lại: 16 Ngày 06:00:03" textFill="#e74c3c" />
                                            </children>
                                        </HBox>

                                        <VBox spacing="12.0">
                                            <children>
                                                <TextField fx:id="txtBidAmount" prefHeight="48.0" promptText="Nhập mức giá của bạn..." style="-fx-background-radius: 12; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 12;" />
                                                <Button fx:id="btnPlaceBid" maxWidth="Infinity" onAction="#onPlaceBidClick" prefHeight="50.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 16; -fx-background-radius: 12; -fx-cursor: hand;" text="ĐẶT GIÁ NGAY" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                        <VBox spacing="25.0" HBox.hgrow="ALWAYS">
                            <children>
                                <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                                    <children>
                                        <Label fx:id="lblProductName" text="Tên sản phẩm đấu giá">
                                            <font>
                                                <Font name="System Bold" size="26.0" />
                                            </font>
                                        </Label>
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="MÔ TẢ CHI TIẾT" textFill="#94a3b8" />
                                        <Label fx:id="lblDescription" lineSpacing="1.5" text="Nội dung mô tả sản phẩm sẽ hiển thị tại đây..." textFill="#4b5563" wrapText="true">
                                            <font>
                                                <Font size="15.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <VBox prefHeight="566.0" prefWidth="573.0" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-font-size: 11;" text="DIỄN BIẾN ĐẤU GIÁ" textFill="#3498db" />
                                        <TableView fx:id="tblRecentBids" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colUser" prefWidth="150.0" text="Người đặt" />
                                                <TableColumn fx:id="colBidPrice" prefWidth="150.0" text="Mức giá" />
                                                <TableColumn fx:id="colBidTime" prefWidth="200.0" text="Thời gian" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </content>
</ScrollPane>