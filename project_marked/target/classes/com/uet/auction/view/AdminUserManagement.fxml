<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
    [SỬA so với file gốc]:
    1. Thêm nút "Làm mới" (onRefreshClick) vào thanh tìm kiếm
    2. Thêm Label fx:id="lblUserCount" hiển thị tổng số user
    3. Đổi màu nút Mở khóa từ #34495e sang #27ae60 (xanh lá) cho trực quan hơn
    4. Thêm placeholder cho TableView khi không có dữ liệu
-->
<VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: #f8fafc;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.uet.auction.client.controller.AdminUserManagementController">

    <VBox spacing="5.0">
        <Label text="Quản lý người dùng" textFill="#1e293b">
            <font><Font name="System Bold" size="28.0" /></font>
        </Label>
        <Label text="Quản lý tài khoản, phân quyền và trạng thái hoạt động của thành viên" textFill="#64748b" />
    </VBox>

    <VBox spacing="15.0" VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <TextField fx:id="txtSearchUser"
                       promptText="Nhập tên đăng nhập để tìm kiếm..."
                       prefHeight="38.0" prefWidth="280.0"
                       style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;" />
            <Button onAction="#onSearchClick"
                    prefHeight="38.0" prefWidth="110.0"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                    text="🔍 Tìm kiếm" />
            <!-- [THÊM MỚI] Nút Làm mới - file gốc không có -->
            <Button onAction="#onRefreshClick"
                    prefHeight="38.0" prefWidth="100.0"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                    text="🔄 Làm mới" />
            <Region HBox.hgrow="ALWAYS" />
            <!-- [THÊM MỚI] Label đếm tổng số user - file gốc không có -->
            <Label fx:id="lblUserCount" textFill="#64748b" />
        </HBox>

        <TableView fx:id="tbvUsers" VBox.vgrow="ALWAYS"
                   style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
            <columns>
                <TableColumn fx:id="colUserId"   prefWidth="55.0"  text="ID" />
                <TableColumn fx:id="colUsername" prefWidth="200.0" text="Tên đăng nhập" />
                <TableColumn fx:id="colRole"     prefWidth="130.0" text="Vai trò" />
                <TableColumn fx:id="colBalance"  prefWidth="160.0" text="Số dư (VNĐ)" />
                <TableColumn fx:id="colStatus"   prefWidth="130.0" text="Trạng thái" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <!-- [THÊM MỚI] Placeholder khi bảng rỗng - file gốc không có -->
            <placeholder>
                <Label text="Không có dữ liệu người dùng" textFill="#94a3b8" />
            </placeholder>
        </TableView>

        <HBox spacing="15.0" alignment="CENTER_RIGHT">
            <Button onAction="#onLockUserClick"
                    prefHeight="40.0" prefWidth="150.0"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                    text="🔒 Khóa tài khoản" />
            <!-- [SỬA] Màu nút từ #34495e (xám tối) → #27ae60 (xanh lá) cho rõ hơn -->
            <Button onAction="#onUnlockUserClick"
                    prefHeight="40.0" prefWidth="150.0"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                    text="🔓 Mở khóa" />
        </HBox>
    </VBox>
</VBox>
