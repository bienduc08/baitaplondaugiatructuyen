<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.uet.auction.client.controller.LoginController">
   <children>
      <StackPane prefWidth="740.0" HBox.hgrow="ALWAYS">
         <children>
            <ImageView fitHeight="720.0" fitWidth="740.0" pickOnBounds="true" preserveRatio="false">
               <image>
                  <Image url="@../images/Anhbia.png" />
               </image>
            </ImageView>
         </children>
      </StackPane>

      <VBox alignment="CENTER" prefWidth="540.0" style="-fx-background-color: #f1f5f9;">
         <children>
            <VBox maxWidth="420.0" spacing="30.0" style="-fx-background-color: white; -fx-padding: 50; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);">
               <children>
                  <VBox alignment="CENTER" spacing="15.0">
                     <children>
                        <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../images/Logo_UET.svg.png" />
                           </image>
                        </ImageView>
                        <Label style="-fx-font-weight: bold;" text="Chào mừng bạn đến với UET!" textFill="#1e293b">
                           <font><Font size="22.0" /></font>
                        </Label>
                        <Label style="-fx-font-size: 13;" text="Cổng đăng nhập hệ thống Đại học Công nghệ" textFill="#64748b" />
                     </children>
                  </VBox>

                  <VBox spacing="20.0">
                     <children>
                        <TextField fx:id="usernameField" prefHeight="50.0" promptText="Tên đăng nhập" style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 0 15;" />
                        <PasswordField fx:id="passwordField" prefHeight="50.0" promptText="Mật khẩu" style="-fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10; -fx-padding: 0 15;" />
                        <Label fx:id="statusLabel" textFill="RED" style="-fx-font-size: 12;" />
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Button style="-fx-background-color: transparent; -fx-text-fill: #3b82f6; -fx-cursor: hand; -fx-padding: 0; -fx-font-size: 13;" text="Quên mật khẩu?" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <VBox spacing="20.0">
                     <children>
                        <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLoginButton" prefHeight="55.0" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16; -fx-background-radius: 10; -fx-cursor: hand;" text="ĐĂNG NHẬP NGAY" />

                        <HBox alignment="CENTER" spacing="5.0">
                           <children>
                              <Label style="-fx-font-size: 14;" text="Bạn là thành viên mới?" textFill="#475569" />
                              <Button onAction="#handleRegisterButton" style="-fx-background-color: transparent; -fx-text-fill: #d97706; -fx-cursor: hand; -fx-padding: 0; -fx-font-size: 14; -fx-font-weight: bold;" text="Đăng ký đấu giá" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>